# =============================================================
# Variables de entorno — BJXMODA React app
# =============================================================
# Copia este archivo a ".env" y completa los valores.
#
# IMPORTANTE: cualquier variable que empiece con VITE_ es incluida
# en el build final y queda visible en el navegador. NUNCA pongas
# aquí contraseñas, client secrets, credenciales de service account
# ni tokens privados. Esos secretos viven únicamente en
# "Script Properties" dentro de Google Apps Script (backend).
# =============================================================

# URL del Web App de Google Apps Script (la que obtienes al hacer
# "Implementar > Nueva implementación > Aplicación web").
# Es una URL pública por diseño: el propio Apps Script es quien
# valida y autoriza cada operación del lado del servidor.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_DE_DESPLIEGUE/exec
